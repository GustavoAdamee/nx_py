arr.ctypes.data = 0xAC8F8C6C0 (same as Elixir: true); OWNDATA = false; arr = [99, 2, 3, 4, 5]
$ lldb --batch -p 1494 -o "memory read --format d --size 4 --count 5 0xAC8F8C6C0"
