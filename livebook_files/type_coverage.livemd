# Type Coverage — TCC 2

## Setup

```elixir
Mix.install([
  {:nx, github: "elixir-nx/nx", sparse: "nx", override: true, ref: "4c741d35"},
  {:pythonx, "~> 0.4.7"}
])

Pythonx.uv_init("""
[project]
name = "project"
version = "0.0.0"
requires-python = "==3.13.*"
dependencies = [
  "numpy==2.2.2",
  "ml-dtypes==0.5.0"
]
""")
```

## Type Mapper

Extended from `poc.livemd` to cover all 20 Nx types: native NumPy (13 types), ml_dtypes
(`{:bf, 16}`, `{:f, 8}`, `{:f8_e4m3fn, 8}`), and widening cast to int8/uint8 for
sub-byte types (`{:s, 2}`, `{:s, 4}`, `{:u, 2}`, `{:u, 4}`).

```elixir
defmodule NxNumpyBridge do
  # Standard floats — native NumPy
  def nx_dtype_to_numpy(%{type: {:f, 64}}),  do: "float64"
  def nx_dtype_to_numpy(%{type: {:f, 32}}),  do: "float32"
  def nx_dtype_to_numpy(%{type: {:f, 16}}),  do: "float16"
  # Brain float and fp8 — via ml_dtypes
  def nx_dtype_to_numpy(%{type: {:bf, 16}}),         do: "bfloat16"
  def nx_dtype_to_numpy(%{type: {:f, 8}}),            do: "float8_e5m2"
  def nx_dtype_to_numpy(%{type: {:f8_e4m3fn, 8}}),   do: "float8_e4m3fn"
  # Signed integers — native NumPy
  def nx_dtype_to_numpy(%{type: {:s, 64}}),  do: "int64"
  def nx_dtype_to_numpy(%{type: {:s, 32}}),  do: "int32"
  def nx_dtype_to_numpy(%{type: {:s, 16}}),  do: "int16"
  def nx_dtype_to_numpy(%{type: {:s,  8}}),  do: "int8"
  # Sub-byte signed — no NumPy native; caller must widen to {:s, 8} first
  def nx_dtype_to_numpy(%{type: {:s, 2}}), do: raise("sub-byte: widen to {:s, 8} first")
  def nx_dtype_to_numpy(%{type: {:s, 4}}), do: raise("sub-byte: widen to {:s, 8} first")
  # Unsigned integers — native NumPy
  def nx_dtype_to_numpy(%{type: {:u, 64}}),  do: "uint64"
  def nx_dtype_to_numpy(%{type: {:u, 32}}),  do: "uint32"
  def nx_dtype_to_numpy(%{type: {:u, 16}}),  do: "uint16"
  def nx_dtype_to_numpy(%{type: {:u,  8}}),  do: "uint8"
  # Sub-byte unsigned — no NumPy native; caller must widen to {:u, 8} first
  def nx_dtype_to_numpy(%{type: {:u, 2}}), do: raise("sub-byte: widen to {:u, 8} first")
  def nx_dtype_to_numpy(%{type: {:u, 4}}), do: raise("sub-byte: widen to {:u, 8} first")
  # Complex — native NumPy
  def nx_dtype_to_numpy(%{type: {:c, 64}}),  do: "complex64"
  def nx_dtype_to_numpy(%{type: {:c, 128}}), do: "complex128"
end
```

## Bridge Implementations

Both bridge modules from `poc.livemd`, redefined here for independence.

```elixir
defmodule NxNumpyBridgePOC do
  def run(x) do
    {x, python_callback(x)}
  end

  def python_callback(tensor) do
    {tensor, original_type} = maybe_widen(tensor)
    dtype = NxNumpyBridge.nx_dtype_to_numpy(tensor)
    data = Nx.to_binary(tensor)
    shape = Nx.shape(tensor)

    {py_result, _env} =
      Pythonx.eval(
        """
        import numpy as np, ml_dtypes
        dtype_str = dtype.decode() if isinstance(dtype, bytes) else dtype
        dtype_obj = getattr(ml_dtypes, dtype_str, None) or np.dtype(dtype_str)

        def main(data, shape, dtype_obj):
          x = np.frombuffer(data, dtype=dtype_obj).reshape(shape)
          y = x * 10
          return (y.tobytes(), y.shape)

        main(data, tuple(shape), dtype_obj)
        """,
        %{"data" => data, "shape" => Tuple.to_list(shape), "dtype" => dtype}
      )

    {out_data, out_shape} = Pythonx.decode(py_result)
    out_data
    |> Nx.from_binary(tensor.type)
    |> Nx.reshape(out_shape)
    |> maybe_narrow(original_type)
  end

  defp maybe_widen(%{type: {:s, n}} = t) when n < 8, do: {Nx.as_type(t, {:s, 8}), t.type}
  defp maybe_widen(%{type: {:u, n}} = t) when n < 8, do: {Nx.as_type(t, {:u, 8}), t.type}
  defp maybe_widen(t),                                do: {t, nil}

  defp maybe_narrow(result, nil),        do: result
  defp maybe_narrow(result, orig_type),  do: Nx.as_type(result, orig_type)
end
```

```elixir
defmodule NxNumpyViewBased do
  # Uses ndarray.view(np.uint8) to reinterpret result bytes without allocating
  # a new buffer inside NumPy, eliminating the tobytes() intermediate copy.
  # Pythonx still copies at the boundary (Erlang binary encoding) — 2 total
  # copies vs 3 for copy-based.
  def run(x) do
    {x, python_callback_view(x)}
  end

  def python_callback_view(tensor) do
    {tensor, original_type} = maybe_widen(tensor)
    dtype = NxNumpyBridge.nx_dtype_to_numpy(tensor)
    data = Nx.to_binary(tensor)
    shape = Nx.shape(tensor)

    {py_result, _env} =
      Pythonx.eval(
        """
        import numpy as np, ml_dtypes
        dtype_str = dtype.decode() if isinstance(dtype, bytes) else dtype
        dtype_obj = getattr(ml_dtypes, dtype_str, None) or np.dtype(dtype_str)

        x = np.frombuffer(data, dtype=dtype_obj).reshape(tuple(shape))
        y = x * 10
        result = bytes(y.view(np.uint8))
        result
        """,
        %{"data" => data, "shape" => Tuple.to_list(shape), "dtype" => dtype}
      )

    out_data = Pythonx.decode(py_result)
    out_data
    |> Nx.from_binary(tensor.type)
    |> Nx.reshape(shape)
    |> maybe_narrow(original_type)
  end

  defp maybe_widen(%{type: {:s, n}} = t) when n < 8, do: {Nx.as_type(t, {:s, 8}), t.type}
  defp maybe_widen(%{type: {:u, n}} = t) when n < 8, do: {Nx.as_type(t, {:u, 8}), t.type}
  defp maybe_widen(t),                                do: {t, nil}

  defp maybe_narrow(result, nil),        do: result
  defp maybe_narrow(result, orig_type),  do: Nx.as_type(result, orig_type)
end
```

## Legend

| Symbol      | Meaning                                                                                                                                            |
| ----------- | -------------------------------------------------------------------------------------------------------------------------------------------------- |
| `native`    | Direct `np.frombuffer(data, dtype=dtype)` with a standard NumPy dtype string                                                                       |
| `ml_dtypes` | Requires `import ml_dtypes`; dtype resolved via `getattr(ml_dtypes, dtype)`                                                                        |
| `cast→s8` | Tensor widened to `int8` before Python call; result narrowed back; test uses `* 1` to avoid overflow                                               |
| `cast→u8` | Tensor widened to `uint8` before Python call; result narrowed back; test uses `* 1` to avoid overflow                                              |
| `✓`       | Round-trip correct                                                                                                                                 |
| `~`         | Passes with precision caveat — low-precision type; small integer test data passes, general use (fractional values or large integers) may diverge |
| `✗`       | Fails                                                                                                                                              |

## Type × Implementation Matrix

Runs `x * 10` through each bridge. For sub-byte types, the expected value is computed
by simulating the bridge's widening path (`widen → *10 → narrow`) so the comparison
is valid even when narrowing wraps values.
Types `{:f, 16}`, `{:bf, 16}`, `{:f, 8}`, and `{:f8_e4m3fn, 8}` are marked `~` (precision caveat — not a failure).

```elixir
types_to_test = [
  # Standard floats — native NumPy
  {:f, 64}, {:f, 32}, {:f, 16},
  # Brain float and fp8 — via ml_dtypes (precision caveats apply)
  {:bf, 16}, {:f, 8}, {:f8_e4m3fn, 8},
  # Signed integers — native NumPy
  {:s, 64}, {:s, 32}, {:s, 16}, {:s, 8},
  # Sub-byte signed integers — widened to int8 (no NumPy native)
  {:s, 4}, {:s, 2},
  # Unsigned integers — native NumPy
  {:u, 64}, {:u, 32}, {:u, 16}, {:u, 8},
  # Sub-byte unsigned integers — widened to uint8 (no NumPy native)
  {:u, 4}, {:u, 2},
  # Complex — native NumPy
  {:c, 64}, {:c, 128}
]

implementations = [
  {"Copy-based",  fn t -> elem(NxNumpyBridgePOC.run(t), 1) end},
  {"View-based",  fn t -> elem(NxNumpyViewBased.run(t), 1) end}
]

precision_caveat_types = [{:f, 16}, {:bf, 16}, {:f, 8}, {:f8_e4m3fn, 8}]

header =
  String.pad_trailing("Type", 18) <>
  String.pad_trailing("Strategy", 14) <>
  Enum.map_join(implementations, "", fn {name, _} -> String.pad_trailing(name, 20) end)

IO.puts(header)
IO.puts(String.duplicate("-", String.length(header)))

Enum.each(types_to_test, fn type ->
  strategy = case type do
    {:bf, 16}          -> "ml_dtypes"
    {:f, 8}            -> "ml_dtypes"
    {:f8_e4m3fn, 8}    -> "ml_dtypes"
    {:s, n} when n < 8 -> "cast→s8"
    {:u, n} when n < 8 -> "cast→u8"
    _                   -> "native"
  end

  # Wrap the full per-type flow so tensor creation errors are caught per-type,
  # not just errors inside the bridge call.
  result_cols =
    try do
      # Sub-byte types: expected simulates the bridge's widening path (widen → *10 → narrow),
      # so the comparison is valid even though values wrap on narrowing.
      # fp8/float types: expected is tensor * 10 (precision caveat types are always marked ~).
      {tensor, expected} = case type do
        {:f8_e4m3fn, 8} ->
          t = Nx.tensor([0, 1, 2, 3, 4]) |> Nx.as_type(type)
          {t, Nx.multiply(t, 10)}
        {:f, 8} ->
          t = Nx.iota({10}) |> Nx.as_type(type)
          {t, Nx.multiply(t, 10)}
        {:s, 2} ->
          t = Nx.tensor([-2, -1, 0, 1]) |> Nx.as_type(type)
          {t, t |> Nx.as_type({:s, 8}) |> Nx.multiply(10) |> Nx.as_type(type)}
        {:s, 4} ->
          t = Nx.iota({8}) |> Nx.as_type(type)
          {t, t |> Nx.as_type({:s, 8}) |> Nx.multiply(10) |> Nx.as_type(type)}
        {:u, 2} ->
          t = Nx.tensor([0, 1, 2, 3]) |> Nx.as_type(type)
          {t, t |> Nx.as_type({:u, 8}) |> Nx.multiply(10) |> Nx.as_type(type)}
        {:u, 4} ->
          t = Nx.iota({8}) |> Nx.as_type(type)
          {t, t |> Nx.as_type({:u, 8}) |> Nx.multiply(10) |> Nx.as_type(type)}
        _ ->
          t = Nx.iota({100}) |> Nx.as_type(type)
          {t, Nx.multiply(t, 10)}
      end

      Enum.map_join(implementations, "", fn {_name, run_fn} ->
        status =
          try do
            result = run_fn.(tensor)
            match = Nx.to_flat_list(result) == Nx.to_flat_list(expected)
            cond do
              match and type in precision_caveat_types -> "✓*"
              match                                    -> "✓"
              type in precision_caveat_types           -> "~ MISMATCH"
              true                                     -> "✗ MISMATCH"
            end
          rescue
            e -> "✗ #{Exception.message(e)}"
          end
        String.pad_trailing(status, 20)
      end)
    rescue
      e -> String.pad_trailing("✗ #{Exception.message(e)}", 40)
    end

  IO.puts(
    String.pad_trailing(inspect(type), 18) <>
    String.pad_trailing(strategy, 14) <>
    result_cols
  )
end)
```

## Multi-Dimensional Tensor Validation

Confirms both bridge implementations preserve tensor shape for 2D and 3D
tensors. Uses `{:f, 64}` as the representative type.

```elixir
shapes_to_test = [{100, 100}, {10, 10, 10}]

implementations = [
  {"Copy-based", fn t -> elem(NxNumpyBridgePOC.run(t), 1) end},
  {"View-based", fn t -> elem(NxNumpyViewBased.run(t), 1) end}
]

IO.puts("Multi-dimensional tensor shape and value preservation:\n")

Enum.each(shapes_to_test, fn shape ->
  tensor = Nx.iota(shape) |> Nx.as_type({:f, 64})
  expected = Nx.multiply(tensor, 10)

  IO.puts("Shape #{inspect(shape)}:")

  Enum.each(implementations, fn {name, run_fn} ->
    {status, shape_str} =
      try do
        result = run_fn.(tensor)
        shape_ok  = Nx.shape(result) == shape
        values_ok = Nx.to_flat_list(result) == Nx.to_flat_list(expected)
        s = if shape_ok and values_ok, do: "✓", else: "✗"
        {s, inspect(Nx.shape(result))}
      rescue
        e -> {"✗ ERROR", Exception.message(e)}
      end
    IO.puts("  #{status} #{name} — output shape: #{shape_str}")
  end)

  IO.puts("")
end)
```
